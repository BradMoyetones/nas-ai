{
    "compilerOptions": {
        /* Base Options: */
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,

        /* Strictness */
        "strict": true,
        "noImplicitAny": false,

        /* Directory Options */
        "rootDir": "./src",
        "outDir": "./dist",

        /* Emit */
        "sourceMap": true,

        /* Type Checking */
        "baseUrl": ".",
        "paths": {
            "*": ["node_modules/*", "src/types/*"]
        }
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist"]
}
