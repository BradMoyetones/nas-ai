        "@openrouter/sdk": "^1.3.28",
        "@prisma/adapter-better-sqlite3": "^7.10.0",
        "@prisma/client": "^7.10.0",
        "ai": "^7.0.114",
        "bcryptjs": "^3.0.3",
        "dotenv": "^17.4.2",
        "groq-sdk": "^1.6.0",
        "hono": "^4.6.14",
