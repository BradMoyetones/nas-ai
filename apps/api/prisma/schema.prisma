generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id              String              @id @default(uuid())
  username        String              @unique
  email           String              @unique
  password        String
  isVerified      Boolean             @default(false)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  conversations   Conversation[]
  auth            UserAuth?
  verifications   EmailVerification[]
  loginChallenges LoginChallenge[]
  credentials     ProviderCredential[]
}

model UserAuth {
  id             String    @id @default(uuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken   String?
  lastLoginAt    DateTime?
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  totpSecret     String?
  totpEnabled    Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model EmailVerification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  type      String    // 'email_verification' | 'password_reset'
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([token])
}

model LoginChallenge {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Conversation {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String    @default("Nueva conversación")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
  
  // Configuración por conversación
  systemPrompt String?   // Prompt de sistema personalizado
  defaultModel String?   // Modelo preferido

  @@index([userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  model          String?
  provider       String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  
  // Seguimiento de uso
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  reasoningTokens  Int?
  durationMs       Int?

  @@index([conversationId])
  @@index([createdAt])
}

model ProviderCredential {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId    String    // 'openai', 'google', 'groq', etc.
  encryptedKey  String    // Cifrado con AES-256-GCM
  iv            String    // Vector de inicialización
  authTag       String    // Tag de autenticación GCM
  label         String?   // "Mi clave OpenAI"
  isValid       Boolean   @default(true)
  lastValidated DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, providerId])
  @@index([userId])
}
